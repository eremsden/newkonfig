    // \uc0\u1044 \u1086 \u1073 \u1072 \u1074 \u1100 \u1090 \u1077  \u1085 \u1086 \u1074 \u1091 \u1102  \u1092 \u1091 \u1085 \u1082 \u1094 \u1080 \u1102  \u1076 \u1083 \u1103  \u1087 \u1088 \u1086 \u1074 \u1077 \u1088 \u1082 \u1080 , \u1074 \u1099 \u1073 \u1088 \u1072 \u1085  \u1083 \u1080  \u1085 \u1072 \u1082 \u1086 \u1085 \u1077 \u1095 \u1085 \u1080 \u1082 \
function isTipSelected(side) \{\
    const selectId = side === 'a' ? 'attach-a' : 'attach-b';\
    const val = document.getElementById(selectId).value.split('|')[0];\
    \
    // \uc0\u1045 \u1089 \u1083 \u1080  \u1101 \u1090 \u1086  \u1079 \u1072 \u1075 \u1086 \u1083 \u1086 \u1074 \u1086 \u1082  \u1080 \u1083 \u1080  \u1088 \u1072 \u1079 \u1076 \u1077 \u1083 \u1080 \u1090 \u1077 \u1083 \u1100  (\u1087 \u1091 \u1089 \u1090 \u1086 \u1077  \u1079 \u1085 \u1072 \u1095 \u1077 \u1085 \u1080 \u1077 ) \u1080 \u1083 \u1080  none\
    return val && val !== '' && !val.startsWith('thread-') && val !== 'none';\
\}\
\
function updateTipImages() \{\
    const series = document.getElementById('series').value;\
    const conn = document.getElementById('connection').value;\
    \
    // \uc0\u1054 \u1089 \u1085 \u1086 \u1074 \u1085 \u1072 \u1103  \u1082 \u1072 \u1088 \u1090 \u1080 \u1085 \u1082 \u1072  \u1087 \u1088 \u1091 \u1078 \u1080 \u1085 \u1099 \
    document.getElementById('img-spring').src = `img/springs/$\{series\}-$\{conn\}.png`;\
\
    if (conn === "threaded") \{\
        const valAraw = document.getElementById('attach-a').value; // \uc0\u1057 \u1090 \u1086 \u1088 \u1086 \u1085 \u1072  B (\u1064 \u1090 \u1086 \u1082 )\
        const valBraw = document.getElementById('attach-b').value; // \uc0\u1057 \u1090 \u1086 \u1088 \u1086 \u1085 \u1072  A (\u1058 \u1088 \u1091 \u1073 \u1082 \u1072 )\
        \
        const valA = valAraw ? valAraw.split('|')[0] : "";\
        const valB = valBraw ? valBraw.split('|')[0] : "";\
        \
        const tipA = attachments.find(a => a.id === valA);\
        const tipB = attachments.find(a => a.id === valB);\
        \
        // \uc0\u1054 \u1073 \u1085 \u1086 \u1074 \u1083 \u1103 \u1077 \u1084  \u1082 \u1072 \u1088 \u1090 \u1080 \u1085 \u1082 \u1091  \u1076 \u1083 \u1103  \u1057 \u1090 \u1086 \u1088 \u1086 \u1085 \u1099  B (\u1064 \u1090 \u1086 \u1082 )\
        if (valA && tipA) \{\
            document.getElementById('img-a').src = tipA.img;\
        \} else \{\
            document.getElementById('img-a').src = "img/tips/none.png";\
        \}\
\
        // \uc0\u1054 \u1073 \u1085 \u1086 \u1074 \u1083 \u1103 \u1077 \u1084  \u1082 \u1072 \u1088 \u1090 \u1080 \u1085 \u1082 \u1091  \u1076 \u1083 \u1103  \u1057 \u1090 \u1086 \u1088 \u1086 \u1085 \u1099  A (\u1058 \u1088 \u1091 \u1073 \u1082 \u1072 )\
        if (valB && tipB) \{\
            document.getElementById('img-b').src = tipB.img;\
        \} else \{\
            document.getElementById('img-b').src = "img/tips/none.png";\
        \}\
        \
        // \uc0\u1042 \u1080 \u1076 \u1080 \u1084 \u1086 \u1089 \u1090 \u1100  \u1082 \u1085 \u1086 \u1087 \u1086 \u1082  \u1079 \u1091 \u1084 \u1072 \
        const zoomHintA = document.querySelector('#box-a .zoom-hint');\
        const zoomHintB = document.querySelector('#box-b .zoom-hint');\
        if (zoomHintA) zoomHintA.style.display = isTipSelected('a') ? 'flex' : 'none';\
        if (zoomHintB) zoomHintB.style.display = isTipSelected('b') ? 'flex' : 'none';\
        \
    \} else \{\
        // \uc0\u1044 \u1083 \u1103  \u1089 \u1074 \u1072 \u1088 \u1085 \u1086 \u1075 \u1086  \u1090 \u1080 \u1087 \u1072 \
        document.getElementById('img-a').src = "img/tips/welded-eye.png";\
        document.getElementById('img-b').src = "img/tips/welded-eye.png";\
    \}\
\}\
