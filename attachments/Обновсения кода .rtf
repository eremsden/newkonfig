    // 3. \uc0\u1047 \u1072 \u1087 \u1086 \u1083 \u1085 \u1103 \u1077 \u1084  \u1096 \u1072 \u1073 \u1083 \u1086 \u1085 \
    document.getElementById('pdf-date').innerText = new Date().toLocaleDateString('ru-RU');\
    document.getElementById('pdf-article').innerText = article;\
    document.getElementById('pdf-series').innerText = series;\
    document.getElementById('pdf-dims').innerText = dimsText;\
    document.getElementById('pdf-force').innerText = force;\
    document.getElementById('pdf-l1').innerText = l1;\
    document.getElementById('pdf-conn').innerText = connType;\
\
    // --- \uc0\u1047 \u1040 \u1055 \u1054 \u1051 \u1053 \u1071 \u1045 \u1052  \u1050 \u1054 \u1051 \u1054 \u1053 \u1050 \u1048  (\u1058 \u1045 \u1055 \u1045 \u1056 \u1068  \u1055 \u1056 \u1040 \u1042 \u1048 \u1051 \u1068 \u1053 \u1067 \u1049  \u1055 \u1054 \u1056 \u1071 \u1044 \u1054 \u1050 ) ---\
    \
    // \uc0\u1051 \u1077 \u1074 \u1072 \u1103  \u1082 \u1086 \u1083 \u1086 \u1085 \u1082 \u1072  PDF (\u1064 \u1090 \u1086 \u1082 ) -> \u1041 \u1077 \u1088 \u1077 \u1084  \u1076 \u1072 \u1085 \u1085 \u1099 \u1077  \u1080 \u1079  'a' (\u1074 \u1072 \u1096 \u1072  \u1089 \u1090 \u1086 \u1088 \u1086 \u1085 \u1072  B)\
    document.getElementById('pdf-name-rod').innerText = nameRod;\
    document.getElementById('pdf-img-rod').src = document.getElementById('img-a').src;\
\
    // \uc0\u1055 \u1088 \u1072 \u1074 \u1072 \u1103  \u1082 \u1086 \u1083 \u1086 \u1085 \u1082 \u1072  PDF (\u1058 \u1088 \u1091 \u1073 \u1082 \u1072 ) -> \u1041 \u1077 \u1088 \u1077 \u1084  \u1076 \u1072 \u1085 \u1085 \u1099 \u1077  \u1080 \u1079  'b' (\u1074 \u1072 \u1096 \u1072  \u1089 \u1090 \u1086 \u1088 \u1086 \u1085 \u1072  A)\
    document.getElementById('pdf-name-tube').innerText = nameTube;\
    document.getElementById('pdf-img-tube').src = document.getElementById('img-b').src;\
    \
    // \uc0\u1054 \u1089 \u1085 \u1086 \u1074 \u1085 \u1072 \u1103  \u1082 \u1072 \u1088 \u1090 \u1080 \u1085 \u1082 \u1072 \
    document.getElementById('pdf-main-img').src = document.getElementById('img-spring').src;\
\
\
    // 4. \uc0\u1043 \u1077 \u1085 \u1077 \u1088 \u1080 \u1088 \u1091 \u1077 \u1084  PDF\
    const \{ jsPDF \} = window.jspdf;\
    const element = document.getElementById('pdf-template');\
    \
    const btn = event.target; // \uc0\u1050 \u1085 \u1086 \u1087 \u1082 \u1072 , \u1085 \u1072  \u1082 \u1086 \u1090 \u1086 \u1088 \u1091 \u1102  \u1085 \u1072 \u1078 \u1072 \u1083 \u1080 \
    const oldText = btn.innerText;\
    btn.innerText = "\uc0\u1043 \u1045 \u1053 \u1045 \u1056 \u1040 \u1062 \u1048 \u1071 ...";\
    btn.disabled = true;\
\
    try \{\
        const canvas = await html2canvas(element, \{\
            scale: 2,\
            useCORS: true,\
            logging: false,\
            allowTaint: false\
        \});\
\
        const imgData = canvas.toDataURL('image/jpeg', 1.0);\
        const pdf = new jsPDF('p', 'mm', 'a4');\
        const pdfWidth = pdf.internal.pageSize.getWidth();\
        const pdfHeight = (canvas.height * pdfWidth) / canvas.width;\
\
        pdf.addImage(imgData, 'JPEG', 0, 0, pdfWidth, pdfHeight);\
        pdf.save(`Dikon_GasSpring_$\{article.replace(/\\//g, '-')\}.pdf`);\
        \
    \} catch (err) \{\
        console.error("\uc0\u1054 \u1096 \u1080 \u1073 \u1082 \u1072  PDF:", err);\
        alert("\uc0\u1053 \u1077  \u1091 \u1076 \u1072 \u1083 \u1086 \u1089 \u1100  \u1089 \u1086 \u1079 \u1076 \u1072 \u1090 \u1100  PDF. \u1055 \u1086 \u1078 \u1072 \u1083 \u1091 \u1081 \u1089 \u1090 \u1072 , \u1087 \u1086 \u1087 \u1088 \u1086 \u1073 \u1091 \u1081 \u1090 \u1077  \u1077 \u1097 \u1077  \u1088 \u1072 \u1079 .");\
    \} finally \{\
        btn.innerText = oldText;\
        btn.disabled = false;\
    \}\
\}\
</script>\
