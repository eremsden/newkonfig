    function fillAttach(id, series) \{\
    const sel = document.getElementById(id);\
    sel.innerHTML = "";\
    \
    // \uc0\u1057 \u1086 \u1079 \u1076 \u1072 \u1077 \u1084  \u1079 \u1072 \u1075 \u1086 \u1083 \u1086 \u1074 \u1086 \u1082  \u1082 \u1072 \u1082  "\u1087 \u1091 \u1089 \u1090 \u1086 \u1081 " \u1072 \u1082 \u1090 \u1080 \u1074 \u1085 \u1099 \u1081  \u1087 \u1091 \u1085 \u1082 \u1090  \u1087 \u1086  \u1091 \u1084 \u1086 \u1083 \u1095 \u1072 \u1085 \u1080 \u1102 \
    const headerOption = document.createElement('option');\
    headerOption.value = ""; \
    headerOption.text = "\uc0\u1055 \u1054 \u1044 \u1057 \u1054 \u1045 \u1044 \u1048 \u1053 \u1045 \u1053 \u1048 \u1071 ";\
    headerOption.selected = true; \
    sel.appendChild(headerOption);\
    \
    // \uc0\u1056 \u1072 \u1079 \u1076 \u1077 \u1083 \u1080 \u1090 \u1077 \u1083 \u1100 \
    const separatorOption = document.createElement('option');\
    separatorOption.value = "";\
    separatorOption.text = "\uc0\u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 ";\
    separatorOption.disabled = true;\
    sel.appendChild(separatorOption);\
    \
    const isLeftSide = id === 'attach-a'; // true \uc0\u1076 \u1083 \u1103  \u1083 \u1077 \u1074 \u1086 \u1081  \u1082 \u1086 \u1083 \u1086 \u1085 \u1082 \u1080  (\u1096 \u1090 \u1086 \u1082 )\
    \
    attachments.filter(a => \{\
        if (!a.series.includes(series)) return false;\
        if (a.id.startsWith('thread-')) \{\
            return isLeftSide ? a.id.endsWith('-b') : a.id.endsWith('-a');\
        \}\
        return true;\
    \}).forEach(a => \{\
        sel.add(new Option(`$\{a.name\} (+$\{a.dist\}\uc0\u1084 \u1084 )`, `$\{a.id\}|$\{a.dist\}`));\
    \});\
    \
    if (sel.options.length <= 2) \{\
        sel.add(new Option("\uc0\u1053 \u1077 \u1090  \u1076 \u1086 \u1089 \u1090 \u1091 \u1087 \u1085 \u1099 \u1093  \u1085 \u1072 \u1082 \u1086 \u1085 \u1077 \u1095 \u1085 \u1080 \u1082 \u1086 \u1074 ", "none|0"));\
    \}\
\}\
